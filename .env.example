# ------------------------------------------------------------------
# .env.example — copy to `.env` and fill in REAL values locally.
#   cp .env.example .env
# `.env` is ignored by Git. NEVER commit real credentials.
# Scripts read these with os.getenv() / python-dotenv.
# ------------------------------------------------------------------

# Device login (lab devices)
DEVICE_USERNAME=admin
DEVICE_PASSWORD=ChangeMe123!
DEVICE_ENABLE_SECRET=ChangeMe123!

# Default connection settings
DEVICE_TYPE=cisco_ios
SSH_PORT=22

# Cisco DevNet Sandbox / controller APIs (optional)
DNAC_HOST=sandboxdnac.example.com
DNAC_USERNAME=devnetuser
DNAC_PASSWORD=ChangeMe123!

# API tokens (optional)
MERAKI_API_KEY=CHANGE_ME
NETBOX_URL=https://netbox.lab.local
NETBOX_TOKEN=CHANGE_ME
